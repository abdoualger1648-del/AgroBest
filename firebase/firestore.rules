rules_version = '2';

// Règles de sécurité Firestore — Agricole DZ 360
//
// C'est ICI que se trouve la protection, pas dans la clé d'API : celle-ci est
// publiée dans l'application et n'autorise rien par elle-même.
//
// Règle qui porte tout le modèle (D49) : un utilisateur peut lire sa ligne et
// écrire ses DEMANDES, mais **jamais** son propre champ `actif` ni son propre
// `niveau`. Seul un compte administrateur les écrit.
//
// Deux droits distincts :
//   `actif`  ouvre les 28 leçons ;
//   `niveau` ouvre plusieurs dossiers (« standard » ou « multi »).
//
// Un administrateur est désigné par l'existence du document `admins/{uid}`,
// que seule la console Firebase peut créer. Aucune adresse personnelle ne
// figure donc dans ces règles ni dans le code.

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function estLeSien(uid) {
      return estConnecte() && request.auth.uid == uid;
    }

    function estAdmin() {
      return estConnecte()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function champsModifies() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /utilisateurs/{uid} {

      allow get: if estLeSien(uid) || estAdmin();
      allow list: if estAdmin();

      // À la création, le compte est forcément inactif, au niveau de base, et
      // porte l'adresse réellement authentifiée : on ne s'active pas soi-même,
      // on ne se donne pas de niveau, et on ne s'inscrit pas sous l'adresse
      // d'un autre.
      allow create: if estLeSien(uid)
        && request.resource.data.actif == false
        && request.resource.data.activeLe == null
        && request.resource.data.get('niveau', 'standard') == 'standard'
        && request.resource.data.email == request.auth.token.email;

      // L'utilisateur ne peut toucher QUE les dates de ses demandes, et ni son
      // activation ni son niveau n'ont le droit de bouger au passage.
      // `get(champ, défaut)` couvre les comptes créés avant que le niveau
      // existe : leur document n'a pas encore ce champ.
      allow update: if estLeSien(uid)
        && champsModifies().hasOnly(['demandeLe', 'demandeNiveauLe'])
        && request.resource.data.actif == resource.data.actif
        && request.resource.data.get('niveau', 'standard')
             == resource.data.get('niveau', 'standard');

      // L'administrateur ne touche QUE les droits : activation et niveau.
      allow update: if estAdmin()
        && champsModifies().hasOnly(['actif', 'activeLe', 'niveau', 'niveauLe']);

      // Un compte ne s'efface pas : on désactive.
      allow delete: if false;
    }

    match /admins/{uid} {
      // Chacun peut vérifier s'il est administrateur, et seulement pour soi.
      allow get: if estLeSien(uid);
      allow list: if false;
      // Se gère exclusivement depuis la console Firebase.
      allow write: if false;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
