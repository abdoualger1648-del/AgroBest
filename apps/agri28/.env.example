# Variables de build de l'application. Copier en `.env.local` pour le
# développement ; en CI, elles viennent des secrets du dépôt.
#
# Aucune de ces valeurs n'est un secret au sens cryptographique : la
# configuration Firebase est publiée dans toute application web, et la
# protection vient des règles de sécurité (`firebase/firestore.rules`).
# L'adresse de l'administrateur, elle, n'est pas dans le dépôt pour une
# raison différente : éviter qu'un robot à spam la récolte.

# Édition : complete (défaut, développement et tests) | apk | vitrine
VITE_EDITION=complete

# Adresse qui reçoit les demandes d'activation (D49).
VITE_EMAIL_ADMIN=

# Projet Firebase visé. Laisser vide pour utiliser celui du code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
